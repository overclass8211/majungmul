# ============================================================
# 마중물 MINISTRY systemd 서비스
# 설치: sudo cp majungmul.service /etc/systemd/system/
#       sudo systemctl daemon-reload
#       sudo systemctl enable --now majungmul
# ============================================================
[Unit]
Description=Majungmul Ministry Web/API Server (port 3100)
After=network.target

[Service]
Type=simple
# ▼ 실제 배포 경로/계정으로 수정하세요
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/majungmul-app
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
# ▼ 포트와 관리자 비밀번호 (반드시 변경!)
Environment=PORT=3100
Environment=ADMIN_PASSWORD=majungmul!

[Install]
WantedBy=multi-user.target
